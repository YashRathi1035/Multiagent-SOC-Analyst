# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60
USE_MOCK_LLM=false

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/soc_analyst.db

# Ingestion Limits
MAX_FILE_SIZE_MB=10

# Detection Rule Thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=10
FAILED_THEN_SUCCESS_WINDOW_MINUTES=15
USER_ENUMERATION_THRESHOLD=3

# Optional Threat Intelligence API Keys (for Phase 3)
# Leaves empty to use offline mock provider
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
